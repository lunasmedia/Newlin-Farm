{
  "name": "template-expo-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "build:plugins": "tsc plugins/example-plugin/src/index.ts --outDir plugins/example-plugin/dist --module commonjs --target ES2017 --esModuleInterop || true",
    "test:plugins": "npm run build:plugins && node scripts/run-plugin-tests.js",
    "publish:plugins": "node scripts/publish-plugins.js"
  },
  "dependencies": {
    "@types/react": "~18.2.14",
    "expo": "^49.0.0",
    "expo-linking": "~5.0.2",
    "expo-router": "^2.0.0",
    "expo-status-bar": "~1.6.0",
    "react": "18.2.0",
    "react-native": "0.72.10",
    "react-native-gesture-handler": "~2.12.0",
    "react-native-safe-area-context": "4.6.3",
    "react-native-screens": "~3.22.0"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.1.4",
    "jest": "^29.6.1",
    "jest-expo": "~49.0.0",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.1.6"
  },
  "overrides": {
    "react-dom": "18.2.0"
  }
}
